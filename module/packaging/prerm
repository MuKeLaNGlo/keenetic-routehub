#!/bin/sh

[ -z "${IPKG_INSTROOT:-}" ] || exit 0

# The daemon detaches its redirect before shutting down the engine.
if [ -x /opt/etc/init.d/S98routehub ]; then
    /opt/etc/init.d/S98routehub stop || exit 1
fi
# Clean up helpers left by a failed or interrupted daemon shutdown.
if [ -s /opt/var/run/routehub-transparent.active ] &&
    [ -x /opt/lib/routehub/routehub-transparent ]; then
    /opt/lib/routehub/routehub-transparent stop || exit 1
fi
if [ -s /opt/var/run/routehub-redirect-tcp.active ] &&
    [ -x /opt/lib/routehub/routehub-redirect-tcp ]; then
    /opt/lib/routehub/routehub-redirect-tcp stop || exit 1
fi
if [ -s /var/run/routehub-zapret/child ] &&
    [ -x /opt/lib/routehub/routehub-zapret ]; then
    /opt/lib/routehub/routehub-zapret stop || exit 1
fi
if [ -s /opt/var/run/routehub-dns/active ] && [ -x /opt/lib/routehub/routehub-dns ]; then
    /opt/lib/routehub/routehub-dns stop || exit 1
fi
